# Google Tag Manager container ID — same container as firmity.in, do not
# create a new one. See gtm-setup-react.md for the GTM-side trigger/tag setup.
# This is also hardcoded as the default in app/layout.tsx (GTM IDs aren't
# secret — they ship in every page's HTML), so this only matters if you
# need a different container for a staging/preview environment.
NEXT_PUBLIC_GTM_ID=GTM-T27H73H4

# Canonical site URL, used for metadata/Open Graph. Set to the real
# production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://firmity.in

# Optional: if set, the lead form API route (app/api/leads/facility-survey)
# forwards each submission to this webhook (CRM, Zapier, internal API, etc).
# If unset, submissions are structured-logged only and the form still
# succeeds — useful for testing the funnel + GTM event before a CRM exists.
LEADS_WEBHOOK_URL=

# Optional: if EMAIL_USER, EMAIL_PASS, and RECEIVER_EMAIL are all set, the
# lead form API route also emails each submission via Gmail SMTP (see
# lib/mailer.ts). EMAIL_PASS must be a Gmail App Password (Google Account ->
# Security -> App passwords), not the account login password. Leave these
# blank to skip email delivery — the form still works via LEADS_WEBHOOK_URL
# or the log-only fallback above.
EMAIL_USER=
EMAIL_PASS=
RECEIVER_EMAIL=
